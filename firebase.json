{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/admin/registration-requests/approve",
        "function": {
          "functionId": "approveRegistrationRequestHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/registration-requests/disable",
        "function": {
          "functionId": "disableRegistrationUserHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/auth/password-reset",
        "function": {
          "functionId": "sendAccountAccessEmailHttp",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  }
}

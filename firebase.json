{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/catalog",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/product",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/cart",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/checkout",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/login",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/orders",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/orders/action",
        "function": {
          "functionId": "orderActionsHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/registration-requests/approve",
        "function": {
          "functionId": "approveRegistrationRequestHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/registration-requests/disable",
        "function": {
          "functionId": "disableRegistrationUserHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/registration-requests/set-admin",
        "function": {
          "functionId": "setRegistrationUserAdminHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/registration-codes",
        "function": {
          "functionId": "registrationCodesAdminHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/auth/registration-code",
        "function": {
          "functionId": "redeemRegistrationCodeHttp",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/auth/password-reset",
        "function": {
          "functionId": "sendAccountAccessEmailHttp",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  }
}
